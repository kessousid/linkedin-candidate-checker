{
  "manifest_version": 3,
  "name": "Curatal LinkedIn Candidate Checker",
  "version": "1.0.0",
  "description": "Check a LinkedIn profile against the Curatal candidate database, and add it if it's not already there.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "activeTab", "clipboardRead", "sidePanel", "alarms"],
  "host_permissions": ["https://www.linkedin.com/*", "https://staging.curatal.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/search/results/people/*"],
      "js": ["pdf-builder.js", "search-content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
